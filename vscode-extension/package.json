{
  "name": "kynoptic-editor-extension",
  "displayName": "Kynoptic Editor Events",
  "description": "Reports real editor events (file focus, language, debug state) to the local kynoptic dashboard. Metadata only - never reads file contents.",
  "version": "0.1.0",
  "publisher": "kynoptic",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Kynoptic",
      "properties": {
        "kynoptic.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:8420",
          "description": "Base URL of the local kynoptic dashboard (loopback only)."
        },
        "kynoptic.extToken": {
          "type": "string",
          "default": "",
          "description": "Extension token shown on the dashboard settings page (data/ext-token.txt). Required for reporting."
        },
        "kynoptic.flushSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 60,
          "description": "Batch flush interval in seconds."
        },
        "kynoptic.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable event reporting to the local dashboard."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "typecheck": "tsc --noEmit -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.3.0"
  }
}
